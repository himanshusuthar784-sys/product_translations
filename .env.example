# Copy to .env. docker-compose reads this file.

# --- Postgres (dedicated container `si-db`; host port 5433) ---
POSTGRES_DB=translations
POSTGRES_USER=si
POSTGRES_PASSWORD=si_dev_password
POSTGRES_PORT_HOST=5433

# --- Application ---
# Async DSN used by the API, sync DSN used by Celery workers / Alembic / scripts.
DATABASE_URL_ASYNC=postgresql+asyncpg://si:si_dev_password@si-db:5432/translations
DATABASE_URL_SYNC=postgresql+psycopg://si:si_dev_password@si-db:5432/translations

# --- Redis: the already-running tdebiz-redis-1, isolated on DB 5 + key prefix ---
REDIS_URL=redis://host.docker.internal:6379/5
CELERY_QUEUE=si_migration
CELERY_KEY_PREFIX=si:

# --- Pools (per process) ---
API_DB_POOL_SIZE=10
API_DB_MAX_OVERFLOW=5
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=0

# --- Migration defaults ---
DEFAULT_BATCH_SIZE=2000
MAX_BATCH_ATTEMPTS=5
BATCH_STALE_AFTER_SECONDS=300
TRANSLATION_PROVIDER=copy_english

LOG_LEVEL=INFO
